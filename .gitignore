### Go template
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/Go.AllowList.gitignore
#
# Binaries for programs and plugins
.idea
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

/go-proxy-ipv6-pool/.env.dev
/go-proxy-ipv6-pool/.env
/.env

# build.sh 产出的二进制，由 docker compose 挂载进容器
/bin/

# Python 诊断脚本缓存
__pycache__/

# 子包目录里 `go build` 的默认产物（与目录同名），不纳入版本管理
/go-proxy-ipv6-pool/go-proxy-ipv6-pool
